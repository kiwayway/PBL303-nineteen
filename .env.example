# Salin jadi .env lalu isi. File .env TIDAK boleh di-commit.
SECRET_KEY=isi-string-acak-panjang
DB_PASSWORD=isi-password-database-huruf-angka-saja

# Email OTP (opsional). Kosongkan MAIL_SERVER saat dev: kode OTP muncul di `docker compose logs web`.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@nineteen.local

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Email tujuan untuk pesan dari halaman Contact Us
CONTACT_EMAIL=nineteenofficial3@gmail.com
