# Salin jadi .env lalu isi. File .env TIDAK boleh di-commit.
SECRET_KEY=isi-string-acak-panjang
DB_PASSWORD=isi-password-database-huruf-angka-saja

# Email OTP (opsional). Kosongkan MAIL_SERVER saat dev: kode OTP muncul di `docker compose logs web`.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@nineteen.local

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Email tujuan untuk pesan dari halaman Contact Us
CONTACT_EMAIL=nineteenofficial3@gmail.com

# Pembayaran transfer manual (kosongkan sampai rekening resmi tersedia)
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=

# Kunci enkripsi data sensitif (nomor rekening). Kosong = diturunkan dari SECRET_KEY (hanya untuk dev).
# Produksi: buat dengan `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
DATA_ENCRYPTION_KEY=

# --- Pembayaran Midtrans (kosong = pakai transfer manual + bukti bayar) ---
# Ambil Server Key SANDBOX dari dashboard Midtrans (Settings > Access Keys). Jangan pernah di-commit.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# URL publik situs (untuk tautan kembali dari Midtrans), mis. https://nineteen.example.com
PUBLIC_BASE_URL=
# Komisi platform dalam basis point (1000 = 10%), masa tunggu setelah selesai (hari), auto-complete (hari)
COMMISSION_BPS=1000
HOLD_DAYS=3
AUTO_COMPLETE_DAYS=3
